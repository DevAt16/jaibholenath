# Provision the existing worker's values privately; never commit worker.env.
# Keep the same authoritative database and Google budget scope.
MYSQL_HOST=existing-host
MYSQL_PORT=3306
MYSQL_DATABASE=existing-database
MYSQL_USER=existing-user
MYSQL_PASSWORD=existing-password
GOOGLE_PLACES_API_KEY=existing-key
GOOGLE_MAPS_BUDGET_SCOPE=existing-scope
# If supplied by the provider, mount its CA and set MYSQL_SSL_CA to that path.
