# Discovery database. URL-encode special characters in URL usernames/passwords.
DATABASE_URL=mysql://shiva:change-me@localhost:3306/shiva_temple_discovery
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Billing account containing this API key's project. No allowance is enabled
# by this variable alone: confirm current usage with scripts/places_budget.py.
GOOGLE_MAPS_BILLING_ACCOUNT_ID=AAAAAA-BBBBBB-CCCCCC
# Alternatively use a stable local name when the billing account ID is unavailable.
# Use ONE scope and database for all workers on the same billing account.
# Explicit scope takes precedence; never change it to reset request counters.
# GOOGLE_MAPS_BUDGET_SCOPE=local:shiva-discovery

# Used when DATABASE_URL is unset. Password is literal in this form.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shiva_temple_discovery
MYSQL_USER=shiva
MYSQL_PASSWORD=change-me
# For a remote TLS connection, configure the provider's CA certificate path.
# MYSQL_SSL_CA=/secure/path/mysql-ca.pem

# Visitor API: dedicated database/account, with no discovery-table access.
VISITS_DATABASE_URL=mysql://portal_counter:change-me@localhost:3306/portal_visits
VISITS_ALLOWED_ORIGIN=https://yourdomain.example
# VISITS_MYSQL_SSL_CA=/secure/path/mysql-ca.pem
